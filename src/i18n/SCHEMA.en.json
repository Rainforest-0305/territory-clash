{
  "$comment": "FROZEN key schema for Territory Clash i18n. en is the source of truth. Do NOT add/remove/rename keys - every locale is typed against en, so drift is a compile error. Placeholders {likeThis} must survive translation verbatim. No HTML in any value. Numbers arrive pre-formatted via Intl.NumberFormat.",
  "locales": [
    "en",
    "ko",
    "ja",
    "zh-Hans",
    "es",
    "pt-BR",
    "de",
    "fr",
    "ru"
  ],
  "baseLocale": "en",
  "keyCount": 173,
  "namePools": {
    "$comment": "nick.name.* and bot.name.* are PRE-COMPOSED, 64 each. The original code concatenated adjective+noun at runtime (8x8), which breaks adjective-noun gender/number agreement in es/pt-BR/fr/de/ru and word order elsewhere. Do NOT translate these literally: invent 64 distinct, natural, short names per list in your language. Grammatical standalone. <=12 chars preferred, ~16 hard cap. No duplicates within a list, no profanity, no real person/brand names. ko entries are the original 64 concatenations laid out at idx = i*8 + j, so existing users keep identical nicknames.",
    "nick.name.*": {
      "count": 64,
      "register": "gentle / poetic; ko source is adjective + nature noun, e.g. 빠른소나기 = \"swift rain-shower\""
    },
    "bot.name.*": {
      "count": 64,
      "register": "real-estate / land-grab personas, e.g. 성실한부동산 = \"diligent realtor\", 냉철한지주 = \"cold-blooded landlord\""
    }
  },
  "notLocalized": {
    "src/toss/identity.ts INVALID_CATEGORY console.error": "developer-only diagnostic, fires only on Toss console misconfiguration, audience is the dev team - stays Korean",
    "granite.config.ts brand.displayName": "Toss mini-app store listing name for a Korea-only channel, compiled into platform bundles, must match console registration - stays Korean",
    "Korean code comments and both CSS files": "developer documentation - untouched"
  },
